# 复制成 .env 再改（或直接运行 sh init-env.sh 自动生成随机密码）。.env 里是密码，不要提交、不要发给别人。

# 浏览器访问的端口
HTTP_PORT=80

# 镜像版本：latest 是最新一次发布，也可以填某次提交号，升级和回退都靠它
IMAGE_TAG=latest

# 数据库
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# 对象存储（MinIO）：根账号只用来初始化，后端用的是下面 OSS_* 这个只能访问一个桶的用户
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
OSS_BUCKET=app
OSS_ACCESS_KEY=app-user
OSS_SECRET_KEY=

# 后端：JWT 签名密钥（固定下来，重启后大家不用重新登录）；用户表为空时自动创建的初始管理员
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
